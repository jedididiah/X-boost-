{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered customer or administrator account profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "emailVerified", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted role document granting administrator access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Social media marketing service offered on the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "platform": { "type": "string", "enum": ["X", "Instagram", "TikTok", "Facebook", "YouTube", "Telegram", "WhatsApp"] },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "name": { "type": "string", "minLength": 3, "maxLength": 140 },
        "description": { "type": "string", "minLength": 5, "maxLength": 600 },
        "ratePer1000": { "type": "number" },
        "providerRatePer1000": { "type": "number" },
        "marginPercent": { "type": "number" },
        "minQuantity": { "type": "integer" },
        "maxQuantity": { "type": "integer" },
        "estimatedTime": { "type": "string", "minLength": 2, "maxLength": 80 },
        "status": { "type": "string", "enum": ["active", "paused", "maintenance"] },
        "supportsCancel": { "type": "boolean" },
        "supportsRefill": { "type": "boolean" },
        "providerServiceId": { "type": "string", "maxLength": 80 },
        "providerName": { "type": "string", "maxLength": 80 },
        "popular": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "platform", "category", "name", "description", "ratePer1000", "providerRatePer1000", "marginPercent", "minQuantity", "maxQuantity", "estimatedTime", "status", "supportsCancel", "supportsRefill", "providerServiceId", "providerName", "popular", "createdAt", "updatedAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Customer balance ledger summary.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "balance": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD"] },
        "totalDeposited": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastOrderId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "balance", "currency", "totalDeposited", "totalSpent", "lastOrderId", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer social media growth order.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "serviceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "platform": { "type": "string", "enum": ["X", "Instagram", "TikTok", "Facebook", "YouTube", "Telegram", "WhatsApp"] },
        "targetLink": { "type": "string", "minLength": 2, "maxLength": 300 },
        "quantity": { "type": "integer" },
        "charge": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "in_progress", "completed", "partial", "cancelled", "refunded", "failed"] },
        "providerOrderId": { "type": "string", "maxLength": 128 },
        "providerStatus": { "type": "string", "maxLength": 64 },
        "startCount": { "type": "integer" },
        "remains": { "type": "integer" },
        "supportsCancel": { "type": "boolean" },
        "supportsRefill": { "type": "boolean" },
        "cancelRequested": { "type": "boolean" },
        "refillRequested": { "type": "boolean" },
        "refillStatus": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userEmail", "serviceId", "serviceName", "platform", "targetLink", "quantity", "charge", "status", "providerOrderId", "providerStatus", "startCount", "remains", "supportsCancel", "supportsRefill", "cancelRequested", "refillRequested", "refillStatus", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Immutable wallet ledger entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["deposit", "order_debit", "refund", "admin_adjustment"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "gateway": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "description": { "type": "string", "minLength": 2, "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "amount", "balanceAfter", "reference", "orderId", "gateway", "status", "description", "createdAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Payment gateway initialization and server verification record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "gateway": { "type": "string", "enum": ["flutterwave"] },
        "reference": { "type": "string", "minLength": 3, "maxLength": 128 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "NGN", "EUR", "GBP"] },
        "status": { "type": "string", "enum": ["initialized", "pending", "verified", "failed"] },
        "gatewayMessage": { "type": "string", "maxLength": 300 },
        "verifiedByServer": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userEmail", "gateway", "reference", "amount", "currency", "status", "gatewayMessage", "verifiedByServer", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Customer notification message.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "message": { "type": "string", "minLength": 2, "maxLength": 400 },
        "category": { "type": "string", "enum": ["order", "wallet", "system", "support"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "category", "read", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support inquiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "subject": { "type": "string", "minLength": 3, "maxLength": 140 },
        "category": { "type": "string", "enum": ["order", "payment", "refill", "account", "other"] },
        "orderId": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "minLength": 5, "maxLength": 1200 },
        "status": { "type": "string", "enum": ["open", "in_review", "resolved", "closed"] },
        "adminReply": { "type": "string", "maxLength": 1200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userEmail", "subject", "category", "orderId", "message", "status", "adminReply", "createdAt", "updatedAt"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Non-secret platform settings controlled by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "defaultMarginPercent": { "type": "number" },
        "minDepositUsd": { "type": "number" },
        "flutterwaveEnabled": { "type": "boolean" },
        "providerAutoSync": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "supportEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "defaultMarginPercent", "minDepositUsd", "flutterwaveEnabled", "providerAutoSync", "maintenanceMode", "supportEmail", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Platform-wide service or system announcement.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "body": { "type": "string", "minLength": 5, "maxLength": 600 },
        "severity": { "type": "string", "enum": ["info", "notice", "maintenance"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "severity", "active", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user account profiles indexed by Firebase Auth UID."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Authoritative admin membership markers."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Publicly browsable SMM service catalog managed by admins."
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Customer wallet balances protected against client-side inflation."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer SMM orders linked to wallet deductions."
    },
    "/transactions/{txId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Immutable financial transaction ledger."
    },
    "/paymentRecords/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Payment gateway initialization and verification records."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Per-user operational notifications."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Customer support tickets and admin replies."
    },
    "/adminSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AdminSettings" },
      "description": "Public non-secret platform configuration controlled by admins."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Active service announcements authored by admins."
    }
  }
}
