# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Comma-separated administrator email addresses recognized by backend routes
ADMIN_EMAILS=

# Delex Gains SMM Provider API credentials (server-side only, never expose to client)
DELEX_GAINS_API_URL=
DELEX_GAINS_API_KEY=

# Flutterwave Payment Gateway Secrets (server-side only)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
